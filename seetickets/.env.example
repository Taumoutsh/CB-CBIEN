# Copier en .env et compléter (le fichier .env n'est jamais versionné).
# Aucun identifiant Seetickets : le bot réserve sans compte, la connexion se fait sur le téléphone au paiement.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Appel Telegram quand des places sont au panier (CallMeBot, gratuit) : ton @pseudo Telegram.
# À faire une fois : envoyer /start à @CallMeBot_txtbot. Vide = pas d'appel. Tester avec /testappel.
CALLMEBOT_USER=
# CALLMEBOT_LANG=fr-FR-Standard-A   # voix Google « Standard »

# Réglages facultatifs (valeurs par défaut)
# BILLETTERIE=https://web.digitick.com/index-css5-choletbasketmobile-pg1.html   # page listant les matchs
# METHODE_REQUETES=1                 # méthode rapide par requêtes, la méthode des pages en secours (0 = pages seules)
# TRIBUNES=OUEST,AGGLO,REHLKO,EGDC   # ordre de préférence (morceau du nom de la tribune)
# MILIEU=0.6                         # largeur centrale acceptée (0,6 = 60 % central)
# HAUTEUR=0.8                        # rangs acceptés depuis le terrain (0,8 = 80 % de la hauteur)
# PREPARATION_MIN=3                  # démarrage du navigateur avant l'heure d'ouverture
# FENETRE_RAPIDE_MIN=5               # durée du rythme rapide après l'ouverture et après un refus
# RYTHME_RAPIDE_MS=500               # pause entre deux tours en rythme rapide
# VEILLE_S=10                        # pause quand aucune place ne convient
