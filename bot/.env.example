# Copier en .env et compléter (le fichier .env n'est jamais versionné).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cholet Hockey (Billetweb) : coordonnées de l'acheteur, remplies par le bot à chaque réservation.
# Les billets sont envoyés à cet email, à ce nom : mettre les vrais. Téléphone : numéro de portable valide.
ACHETEUR_PRENOM=
ACHETEUR_NOM=
ACHETEUR_EMAIL=
ACHETEUR_TELEPHONE=
ACHETEUR_CODE_POSTAL=
# Ducs d'Angers (Weezevent) : en plus des précédentes ; chaque billet est aussi au nom de l'acheteur.
# Civilité : M. ou Mme ; date de naissance : JJ/MM/AAAA. Pas de commentaire en fin de ligne (Docker l'inclurait).
ACHETEUR_ADRESSE=
ACHETEUR_VILLE=
ACHETEUR_CIVILITE=
ACHETEUR_NAISSANCE=

# ─── Réglages facultatifs (valeurs par défaut) ───
# CLUBS=basket,hockey,angers         # clubs suivis ; le premier est celui des commandes sans club

# Cholet Basket (Seetickets) : aucun identifiant, le bot réserve sans compte
# BASKET_TRIBUNES=OUEST,AGGLO,REHLKO,EGDC   # ordre de préférence (morceau du nom de la tribune)
# BASKET_MILIEU=0.6                  # largeur centrale acceptée (0,6 = 60 % central)
# BASKET_HAUTEUR=0.8                 # rangs acceptés depuis le terrain (0,8 = 80 % de la hauteur)
# BASKET_PREDILECTION=0.65          # zone de prédilection : 65 % de la zone acceptée, centrée en largeur
# BASKET_PREDILECTION_HAUT=1         # zone de prédilection en haut de la zone acceptée, bancs des niveaux 3/4 (0 = centrée)
# BASKET_BILLETTERIE=https://web.digitick.com/index-css5-choletbasketmobile-pg1.html   # page listant les matchs
# BASKET_CALENDRIERS=https://www.cholet-basket.com/calendrier,https://www.cholet-basket.com/calendrier/basketball-champions-league
# METHODE_REQUETES=1                 # méthode rapide par requêtes, la méthode des pages en secours (0 = pages seules)
# (les anciens noms TRIBUNES, MILIEU, HAUTEUR, BILLETTERIE, CALENDRIERS restent acceptés)

# Cholet Hockey (Billetweb)
# HOCKEY_TRIBUNES=MILLET,TRIOWORLD,GRAPHIC  # blocs de la tribune principale, par préférence
# HOCKEY_MILIEU=0.6
# HOCKEY_HAUTEUR=0.8
# HOCKEY_PREDILECTION=0.65          # zone de prédilection, centrée dans la zone acceptée (65 % de sa largeur et de sa hauteur)
# HOCKEY_TARIF=Plein Tarif           # tarif réservé
# HOCKEY_BILLETTERIE=https://www.billetweb.fr/multi_event.php?multi=42133

# Ducs d'Angers (Weezevent)
# ANGERS_ZONES=CENTRALE,VIRAGE        # zones par préférence (morceau du nom)
# ANGERS_ZONES_EXCLUES=LOGE,SALON,CONFLUENCES,DEBOUT
# ANGERS_PREDILECTION=0.65           # zone de prédilection, centrée dans chaque zone
# ANGERS_TARIF=TARIF NORMAL|TARIF UNIQUE|PLEIN TARIF
# ANGERS_BILLETTERIES=365a4f66-826e-4b2e-8bd3-9be8935e239d   # clés des widgets Weezevent du club
# ANGERS_VEILLE=1                    # veille des ventes : ouvertures annoncées signalées sur Telegram (0 = désactivée)
# ANGERS_METHODE_REQUETES=1          # méthode rapide par requêtes, le navigateur en secours (0 = navigateur seul)
# VEILLE_VENTES_MIN=30               # intervalle de la veille des ventes, en minutes

# Rythmes (tous les clubs)
# PREPARATION_MIN=3                  # démarrage du navigateur avant l'heure d'ouverture
# FENETRE_RAPIDE_MIN=5               # durée du rythme rapide après l'ouverture et après un refus
# RYTHME_RAPIDE_MS=500               # pause entre deux tours en rythme rapide
# AVANCE_S=15                        # rythme rapide dès ce délai avant l'heure d'ouverture
# VEILLE_S=10                        # pause quand aucune place ne convient
# REPRISES_PANIER=4                  # panier expiré sans réponse : mêmes places reprises au plus 4 fois, puis écartées
